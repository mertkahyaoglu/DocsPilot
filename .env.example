# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=            # embeddings + rerank. Blank = offline hash embedder (dev only)
DATABASE_URL=postgresql://docspilot:docspilot@127.0.0.1:5433/docspilot   # `make db`
DOCSPILOT_ENV=dev
# DOCSPILOT_LLM_BACKEND=fake   # run the UI without an API key
# DOCSPILOT_MODEL_ANSWER=claude-opus-5-5
# DOCSPILOT_EFFORT_ANSWER=medium
# DOCSPILOT_LOG_JSON=true
# --- observability / cost (all optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318      # Jaeger/Tempo/Langfuse (<host>/api/public/otel)
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic%20...   # backend auth
# DOCSPILOT_TRACE_CONTENT=false                          # redacted prompt/answer text in traces
# DOCSPILOT_PROMPT_CACHING=true
# DOCSPILOT_RESPONSE_CACHE_TTL_S=3600                    # 0 disables
# DOCSPILOT_ROUTING=false                                # small-model triage in front of the agent
# --- safety (Phase 6) ---
# DOCSPILOT_API_KEYS=alice:change-me-to-a-long-random-key,bob:another-long-random-key   # required in prod
# DOCSPILOT_INJECTION_POLICY=redact        # redact | annotate | off (off is refused in prod)
# DOCSPILOT_ALLOWED_HOSTS=acmebilling.example
# DOCSPILOT_RATE_LIMIT_PER_MIN=30
# DOCSPILOT_USER_DAILY_BUDGET_USD=5
# DOCSPILOT_GLOBAL_DAILY_BUDGET_USD=100
# DOCSPILOT_METRICS_TOKEN=                 # required to expose /metrics in prod
